{
  "manifest_version": 3,
  "name": "TapePost信仰者工具",
  "short_name": "TapePost信仰者工具",
  "version": "1.5.10",
  "author": "TapeOut 社区 · 昆哥",
  "minimum_chrome_version": "116",
  "description": "7 站一键转发到 X：逐张去水印 + 4K、视频剪接；免 Key 站内 Grok，可切 xAI / DeepSeek；BEM 行情 + 钱包双链资产（BSC BEM/矿机、X Layer FAB/矿机/OKB）；连钱包为 $BEM 打卡，名片可改可存；导航核验。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TapePost信仰者工具 · 转发 / AI 评论 / 生态面板",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "clipboardWrite",
    "offscreen",
    "declarativeNetRequest",
    "alarms",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://weibo.com/*",
    "https://*.weibo.com/*",
    "https://m.weibo.cn/*",
    "https://*.sinaimg.cn/*",
    "https://*.weibocdn.com/*",
    "https://zhihu.com/*",
    "https://*.zhihu.com/*",
    "https://*.zhimg.com/*",
    "https://mp.weixin.qq.com/*",
    "https://*.qpic.cn/*",
    "https://bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.bfsstatic.com/*",
    "https://douban.com/*",
    "https://*.douban.com/*",
    "https://*.doubanio.com/*",
    "https://xiaohongshu.com/*",
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://*.twimg.com/*",
    "https://api.x.ai/*",
    "https://api.deepseek.com/*",
    "https://api-tapeout.firsto.ai/*",
    "https://tapeout.firsto.ai/*",
    "https://tapeup.io/*",
    "https://*.tapeup.io/*",
    "https://api.tapeapi.fun/*",
    "https://api.fabx.tech/*",
    "https://rpc.xlayer.tech/*",
    "https://xlayerrpc.okx.com/*",
    "https://tapepost-privacy.app.workbuddy.host/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://weibo.com/*",
        "https://*.weibo.com/*",
        "https://m.weibo.cn/*",
        "https://zhihu.com/*",
        "https://*.zhihu.com/*",
        "https://mp.weixin.qq.com/*",
        "https://bilibili.com/*",
        "https://*.bilibili.com/*",
        "https://douban.com/*",
        "https://*.douban.com/*",
        "https://xiaohongshu.com/*",
        "https://*.xiaohongshu.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "account.js",
        "sites.js",
        "promo.js",
        "price-alert.js",
        "content.js",
        "grok-page.js",
        "grok-native-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "grok-native.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://tapeup.io/*",
        "https://*.tapeup.io/*"
      ],
      "js": [
        "price.js",
        "tapeup-price.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
