{
  "manifest_version": 3,
  "name": "TapePost · 一键转发到 X",
  "short_name": "TapePost",
  "version": "1.0.0",
  "author": "TapeOut 社区 · 昆哥",
  "minimum_chrome_version": "116",
  "description": "在微博、知乎、公众号、B站动态、豆瓣、小红书、X 一键提取正文与配图，清洗文字、去水印，预填到 X 由你手动发送。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TapePost · 一键转发到 X · 设置",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "clipboardWrite",
    "offscreen",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://weibo.com/*",
    "https://*.weibo.com/*",
    "https://m.weibo.cn/*",
    "https://*.sinaimg.cn/*",
    "https://*.weibocdn.com/*",
    "https://zhihu.com/*",
    "https://*.zhihu.com/*",
    "https://*.zhimg.com/*",
    "https://mp.weixin.qq.com/*",
    "https://*.qpic.cn/*",
    "https://bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.bfsstatic.com/*",
    "https://douban.com/*",
    "https://*.douban.com/*",
    "https://*.doubanio.com/*",
    "https://xiaohongshu.com/*",
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://*.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://weibo.com/*",
        "https://*.weibo.com/*",
        "https://m.weibo.cn/*",
        "https://zhihu.com/*",
        "https://*.zhihu.com/*",
        "https://mp.weixin.qq.com/*",
        "https://bilibili.com/*",
        "https://*.bilibili.com/*",
        "https://douban.com/*",
        "https://*.douban.com/*",
        "https://xiaohongshu.com/*",
        "https://*.xiaohongshu.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "js": ["account.js", "sites.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
